# Copy this file to `.env` and fill in your credentials.
# `.env` is git-ignored — never commit real keys.

# Pick a known OpenAI-compatible provider:
#   openai | deepseek | mimo | mimo-token-plan | groq | openrouter
DEEPWOLF_PROVIDER=mimo

# ...or set a custom endpoint directly (overrides DEEPWOLF_PROVIDER):
# DEEPWOLF_BASE_URL=https://api.xiaomimimo.com/v1

# Your API key for that provider.
DEEPWOLF_API_KEY=replace-me

# The model id to use, e.g. mimo-v2-flash, gpt-4o-mini, deepseek-chat.
DEEPWOLF_MODEL=mimo-v2-flash

# Optional generation settings.
# DEEPWOLF_TEMPERATURE=0.8
# DEEPWOLF_MAX_TOKENS=600
